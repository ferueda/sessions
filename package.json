{
  "name": "@ferueda/sessions",
  "version": "0.3.0",
  "description": "Local-first search and analysis for AI coding-agent session history",
  "keywords": [
    "agents",
    "cli",
    "codex",
    "cursor",
    "local-first",
    "sessions"
  ],
  "homepage": "https://github.com/ferueda/sessions#readme",
  "bugs": {
    "url": "https://github.com/ferueda/sessions/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferueda/sessions.git"
  },
  "bin": {
    "sessions": "dist/bin/sessions.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {},
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm deps:check && pnpm typecheck && pnpm test && pnpm build && pnpm smoke:dist && pnpm smoke:package",
    "check:ci": "pnpm check",
    "check:docs": "pnpm format:docs:check && pnpm test:docs",
    "clean": "node scripts/clean.ts",
    "deps:check": "node scripts/check-dependencies.ts",
    "format": "oxfmt --write src scripts test skills docs dev .github AGENTS.md README.md CONTRIBUTING.md SECURITY.md CHANGELOG.md package.json release-please-config.json .release-please-manifest.json pnpm-workspace.yaml tsconfig.json tsconfig.build.json vitest.config.ts .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check src scripts test skills docs dev .github AGENTS.md README.md CONTRIBUTING.md SECURITY.md CHANGELOG.md package.json release-please-config.json .release-please-manifest.json pnpm-workspace.yaml tsconfig.json tsconfig.build.json vitest.config.ts .oxlintrc.json .oxfmtrc.json",
    "format:docs:check": "oxfmt --check \"**/*.md\"",
    "lint": "oxlint -c .oxlintrc.json src scripts test vitest.config.ts",
    "lint:fix": "oxlint -c .oxlintrc.json --fix src scripts test vitest.config.ts",
    "measure:content-storage": "node scripts/measure-content-storage.ts",
    "measure:entry-query": "node scripts/measure-entry-query.ts",
    "measure:indexing": "node scripts/measure-indexing.ts",
    "measure:indexing:codex": "node scripts/measure-codex-indexing.ts",
    "measure:indexing:cursor": "node scripts/measure-cursor-indexing.ts",
    "measure:manifest": "node scripts/measure-manifest.ts",
    "measure:query-lineage": "node scripts/measure-query-lineage.ts",
    "measure:search-query": "node scripts/measure-search-query.ts",
    "hooks:install": "simple-git-hooks",
    "prepack": "pnpm build",
    "smoke:dist": "node scripts/smoke-dist.ts",
    "smoke:package": "node scripts/smoke-package.ts",
    "smoke:release-package": "node scripts/smoke-release-package.ts",
    "test": "vitest run",
    "test:docs": "vitest run test/docs-contracts.test.ts test/skill-contracts.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "15.0.0",
    "smol-toml": "1.7.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "lint-staged": "17.1.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "simple-git-hooks": "2.13.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && pnpm typecheck"
  },
  "lint-staged": {
    "{src,scripts,test}/**/*.{ts,js,mjs,cjs,json}": [
      "pnpm exec oxfmt --write --no-error-on-unmatched-pattern",
      "pnpm exec oxlint -c .oxlintrc.json --fix"
    ],
    "{docs,dev,.github,skills}/**/*.{md,json,yml,yaml}": "pnpm exec oxfmt --write --no-error-on-unmatched-pattern",
    "*.{md,json,yml,yaml}": "pnpm exec oxfmt --write --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "pnpm@11.10.0"
}
